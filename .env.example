OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Everything the app writes (exports, blueprint packs, generated projects, later: sessions) lives
# here. Deliberately outside the repository so implementation agents never run next to this file.
OUTPUT_DIR=~/idea-to-mvp

# Offline demo: canned outputs and a stand-in implementation stage, no API keys or spend.
# Try the whole pipeline with:  DEMO_MODE=true uv run idea-to-mvp
DEMO_MODE=false

# Model profile: a cost/quality preset for the models of every role below (panel, summarizer, architect,
# moderator, researcher) and of the implementation agents (task sessions, verification lanes, escalation).
#   fast     the cheapest current models (Haiku 5.5 for the Anthropic roles and agents, gpt-6-luna for the PM,
#            gemini-3.8-flash for the Skeptic); escalated agent sessions on Sonnet 5.5
#   balanced the defaults listed below: Opus 5.5 plans, Sonnet 5.5 builds and verifies, Opus 5.5 takes the hard cases
#   quality  Opus 5.5 for the Tech Lead, summarizer, architect, and every agent session; Fable 5.1 for escalation
# The UI's settings accordion shows the models a profile resolves to; `uv run idea-to-mvp models` prints every
# profile with prices and the cost of a typical run (`--check` also compares with what the providers list today).
# Model IDs, prices, and capabilities live in src/idea_to_mvp/models.toml.
MODEL_PROFILE=balanced

# Per-role overrides. Each line below shows the `balanced` default and is commented out on purpose: setting
# a role's *_PROVIDER or *_MODEL takes that role's provider and model from here and leaves the profile out
# for it (a model belongs to its provider, so set both). Providers: openai | anthropic | google.
# PM_PROVIDER=openai
# TECH_LEAD_PROVIDER=anthropic
# SKEPTIC_PROVIDER=google
# SUMMARIZER_PROVIDER=anthropic
# ARCHITECT_PROVIDER=anthropic
# MODERATOR_PROVIDER=anthropic
# RESEARCH_PROVIDER=anthropic

# PM_MODEL=gpt-6.1-sol
# TECH_LEAD_MODEL=claude-sonnet-5-5
# SKEPTIC_MODEL=gemini-3.8-flash
# SUMMARIZER_MODEL=claude-sonnet-5-5
# The architect's model also writes the strategy and the plan and reviews the pack: its mistakes are paid
# for again in every agent session, so the default is the strongest affordable model.
# ARCHITECT_MODEL=claude-opus-5-5
# The panel moderator makes one small structured call after every turn; a cheap, fast model is enough.
# MODERATOR_MODEL=claude-haiku-5-5
# The researcher (only used when ENABLE_RESEARCH=true) needs a provider with a native web search tool.
# RESEARCH_MODEL=claude-sonnet-5-5

# Sampling: applied only to models that accept it (Claude 4.7+/5.x, GPT-5.x/6.x and Gemini 3.x
# ignore it by design). Leave empty to never send a temperature.
TEMPERATURE=0.7

# Resilience: per-request limits passed to the provider SDKs, which already retry 429/5xx/connection
# errors; a node that still fails transiently is retried again (3 attempts) before the stage fails.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Most model calls in flight at once (the panel's three opening statements run in parallel).
LLM_MAX_CONCURRENCY=4

# Panel: moderated (parallel openings, a moderator picks speakers and may end the debate early)
# | round_robin (fixed PM -> Tech Lead -> Skeptic rotation for the whole turn budget).
# The UI's "Rounds per speaker" is the budget either way: the moderated panel never exceeds it.
PANEL_MODE=moderated

# Research: before the panel starts, a researcher model searches the web with its provider's own search tool
# (Anthropic web search, OpenAI web search, or Gemini Google Search grounding, per RESEARCH_PROVIDER) and a
# short cited brief (competitors with links, market notes, gaps) is given to the panel and shown in the chat.
# Off by default: it adds one search-heavy model call. Web text is treated as untrusted data; the brief is
# validated, and only http(s) links are shown. RESEARCH_MAX_SEARCHES caps searches per run (Anthropic only;
# OpenAI and Gemini decide for themselves). Demo mode answers from a canned brief.
ENABLE_RESEARCH=false
RESEARCH_MAX_SEARCHES=5

# Blueprint review: after the pack is written a critic checks the PRD, architecture, plan, and subagent
# prompts against each other. Documents it flags as blockers are regenerated (with its notes) up to this
# many times; 0 = review and report only. Open notes land in REVIEW.md and are shown at the implement gate.
MAX_BLUEPRINT_REVISIONS=1

# Token limits
DISCUSSION_MAX_TOKENS=900
SKEPTIC_MAX_TOKENS=1200
SUMMARY_MAX_TOKENS=2000
# The structured execution plan (plan.json) is far longer than one prose document.
PLAN_MAX_TOKENS=6000
# The held-out acceptance suite: several test files in one structured answer.
ACCEPTANCE_MAX_TOKENS=8000
# Graph checkpoints: sqlite (sessions survive restarts) | memory (lost on exit).
CHECKPOINTER=sqlite
# CHECKPOINT_DB=~/idea-to-mvp/sessions.db

# Implementation stage (Claude Agent SDK). Requires ANTHROPIC_API_KEY.
# Agents work in $OUTPUT_DIR/projects/<project>/ (a git repository the orchestrator commits to);
# every run is gated behind explicit approval in the UI.
# The agents' models follow MODEL_PROFILE; each line below shows the `balanced` default and is commented out on
# purpose. IMPLEMENTER_MODEL runs the task sessions, VERIFIER_MODEL the read-mostly verification lanes (and the acceptance lane),
# ESCALATION_MODEL the hard cases: the merge-conflict resolver and every fix attempt after the first. Setting
# only IMPLEMENTER_MODEL (as an .env from before v0.4 does) runs every kind of session on it.
# IMPLEMENTER_MODEL=claude-sonnet-5-5
# VERIFIER_MODEL=claude-sonnet-5-5
# ESCALATION_MODEL=claude-opus-5-5
# acceptEdits (default): edits are auto-approved, and so are shell commands while the OS sandbox is on.
# bypassPermissions approves every tool unattended (the implement gate shows a red warning for it).
IMPLEMENTER_PERMISSION_MODE=acceptEdits
# OS sandbox for the agents' shell commands (Seatbelt on macOS, bubblewrap + socat on Linux):
# auto = on where supported, else a loud warning | on = refuse to run without it | off = no sandbox.
# See SECURITY.md for what is and is not protected.
IMPLEMENTER_SANDBOX=auto
# The only hosts sandboxed shell commands may reach (comma-separated):
# IMPLEMENTER_ALLOWED_DOMAINS=pypi.org,files.pythonhosted.org,registry.npmjs.org,github.com
# Prices for the cost figures (the header badge, the implement gate's estimate, the dashboard) come from
# src/idea_to_mvp/models.toml. To use your own (negotiated or in-house) prices, point this at a TOML file with one
# table per model; it wins over the catalog, and any model it lists counts as priced:
#   [prices."claude-sonnet-5-5"]
#   input_per_mtok = 1.5
#   output_per_mtok = 7.5
#   cached_input_per_mtok = 0.15   # optional; cached input is charged at the input price without it
# MODEL_PRICES_FILE=~/idea-to-mvp/prices.toml
# Cost caps. The whole-run cap is shared by every implementation session (and limits the verification lanes
# and fix sessions after them; progress survives a restart, so a resumed run only gets what is left). The per-task
# cap and turn limit bound one fresh session per plan task. IMPLEMENTER_MAX_BUDGET_USD is the old name of
# IMPLEMENTER_MAX_TASK_USD and still works.
IMPLEMENTER_MAX_TOTAL_USD=25.0
IMPLEMENTER_MAX_TASK_USD=5.0
IMPLEMENTER_MAX_TASK_TURNS=40
# Independent plan tasks run at the same time, each in its own git worktree, and are merged back in task-id
# order (a merge conflict gets one bounded resolver session). 1 = one task at a time, directly in the
# workspace. LLM_MAX_CONCURRENCY caps the run overall; every running task reserves IMPLEMENTER_MAX_TASK_USD.
# The implement gate's parallelism selector overrides this default for one run.
IMPLEMENTER_MAX_PARALLEL=3
# Turn limit of a lead session (strategy mode `subagents`), which builds the whole plan in one session.
IMPLEMENTER_MAX_TURNS=120
# Turn limit of each verification lane (tests, quality, requirements: three sessions at once), and how many
# fix-and-reverify rounds a failed verification gets before the delivery report.
VERIFIER_MAX_TURNS=40
MAX_FIX_ATTEMPTS=2
# Test-integrity guard: after every task, merge-resolver, and fix session the orchestrator checks whether the
# session deleted, renamed, or skipped a test, or removed assertions from one, and whether the test report lists
# fewer tests than the round before. `block` (default) fails the verdict until the test is restored or the change
# is justified in the project's quality/TEST_CHANGES.md (`- <path>: <why>`); `warn` only reports it; `off` skips it.
TEST_INTEGRITY=block
# Held-out acceptance tests: before each version is built, an acceptance author (on the architect's model) writes
# black-box tests from the PRD and the plan's public contracts, kept outside the workspace, and a fourth
# verification lane runs them in a throwaway copy. Fix sessions see only the failing test names and assertion
# messages. on | off; unset = on, except in demo mode.
# ACCEPTANCE_TESTS=on
# Behavioral Contrast harness tuning before the first version is built: one pilot task (the first-wave task most
# others depend on) is built three times in throwaway worktrees, under the pack's agent harness and under two
# proposed edits of it (INV: how the agent works; DOM: what a practitioner of the stack knows), each followed by a
# quick tests lane; a composer then keeps the base or adopts what the trajectories show helped, and the result is
# committed as `harness: tuned (pilot T0x)`. A selector compares the pilot builds blind and the best one becomes the
# pilot task's result, so that task is not built again. Costs three extra task sessions, up to three tests lanes, and
# four planning calls (at most half of IMPLEMENTER_MAX_TOTAL_USD); the implement gate shows the estimate and can
# switch it for one run. off | pilot
HARNESS_TUNING=off
# How many versions a project can go through: after each delivery you may request changes, and every round
# builds the next version (v0.2, ...) in the same workspace. Each version has its own whole-run budget.
# 1 = no iteration gate.
MAX_ITERATIONS=5

# Optional tracing (LangSmith). Only LANGSMITH_* / LANGCHAIN_* variables from this file are exported to
# the process; runs are named "idea-to-mvp" and tagged with their thread id.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=idea-to-mvp
