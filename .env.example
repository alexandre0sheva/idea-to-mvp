OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Everything the app writes (exports, blueprint packs, generated projects, later: sessions) lives
# here. Deliberately outside the repository so implementation agents never run next to this file.
OUTPUT_DIR=~/idea-to-mvp

# Offline demo: canned outputs and a stand-in implementation stage, no API keys or spend.
# Try the whole pipeline with:  DEMO_MODE=true uv run idea-to-mvp
DEMO_MODE=false

# Providers: openai | anthropic | google
PM_PROVIDER=openai
TECH_LEAD_PROVIDER=anthropic
SKEPTIC_PROVIDER=google
SUMMARIZER_PROVIDER=anthropic
ARCHITECT_PROVIDER=anthropic

PM_MODEL=gpt-5.6-terra
TECH_LEAD_MODEL=claude-sonnet-5-5
SKEPTIC_MODEL=gemini-3.8-flash
SUMMARIZER_MODEL=claude-sonnet-5-5
ARCHITECT_MODEL=claude-sonnet-5-5

# Sampling: applied only to models that accept it (Claude 4.7+/5.x, GPT-5.x and Gemini 3.x
# ignore it by design). Leave empty to never send a temperature.
TEMPERATURE=0.7

# Resilience: per-request limits passed to the provider SDKs, which already retry 429/5xx/connection
# errors; a node that still fails transiently is retried again (3 attempts) before the stage fails.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Token limits
DISCUSSION_MAX_TOKENS=900
SKEPTIC_MAX_TOKENS=1200
SUMMARY_MAX_TOKENS=2000
# Graph checkpoints: sqlite (sessions survive restarts) | memory (lost on exit).
CHECKPOINTER=sqlite
# CHECKPOINT_DB=~/idea-to-mvp/sessions.db

# Implementation stage (Claude Agent SDK). Requires ANTHROPIC_API_KEY.
# Agents run with their working directory in $OUTPUT_DIR/projects/<project>/;
# every run is gated behind explicit approval in the UI.
IMPLEMENTER_MODEL=claude-opus-5-5
IMPLEMENTER_PERMISSION_MODE=bypassPermissions
IMPLEMENTER_MAX_TURNS=120
IMPLEMENTER_MAX_BUDGET_USD=10.0
VERIFIER_MAX_TURNS=40
MAX_FIX_ATTEMPTS=2

# Optional tracing (LangSmith). Only LANGSMITH_* / LANGCHAIN_* variables from this file are exported to
# the process; runs are named "idea-to-mvp" and tagged with their thread id.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=idea-to-mvp
