OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Providers: openai | anthropic | google
PM_PROVIDER=openai
TECH_LEAD_PROVIDER=anthropic
SKEPTIC_PROVIDER=google
SUMMARIZER_PROVIDER=anthropic
ARCHITECT_PROVIDER=anthropic

PM_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
TECH_LEAD_MODEL=claude-haiku-4-5-20251001
SKEPTIC_MODEL=gemini-3-flash-preview
SUMMARIZER_MODEL=claude-4-6-sonnet-latest
ARCHITECT_MODEL=claude-4-6-sonnet-latest

# Token limits
DISCUSSION_MAX_TOKENS=900
SKEPTIC_MAX_TOKENS=1200
SUMMARY_MAX_TOKENS=2000
ENABLE_CHECKPOINTER=true
